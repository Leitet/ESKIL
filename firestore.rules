rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isSuperAdmin() {
      return isSignedIn() && userRole() == 'super-admin';
    }

    function compData(cid) {
      return get(/databases/$(database)/documents/competitions/$(cid)).data;
    }

    // All sign-ins are email-link, so every authenticated user has a verified
    // email claim. Permissions are email-based (people can be invited before
    // their first sign-in); legacy uid-based admins are still honored.
    function authEmail() {
      return request.auth.token.email.lower();
    }

    // Permission data is being migrated from the world-readable competition
    // doc into a member-only private/access subdoc (Fas 3). During the
    // migration the rules read a UNION of both places, so whichever is
    // populated grants access — a bug on the new side can't lock anyone out
    // while the old side is still dual-written.
    function accessExists(cid) {
      return exists(/databases/$(database)/documents/competitions/$(cid)/private/access);
    }
    function accessData(cid) {
      return get(/databases/$(database)/documents/competitions/$(cid)/private/access).data;
    }

    function isCompAdmin(cid) {
      return isSignedIn() && (isSuperAdmin()
        || request.auth.uid in compData(cid).get('admins', [])
        || authEmail() in compData(cid).get('adminEmails', [])
        || (accessExists(cid) && (
             request.auth.uid in accessData(cid).get('admins', [])
          || authEmail() in accessData(cid).get('adminEmails', [])
        )));
    }

    // Ekonomiansvarig/kassör — appointed via a Tävlingsledning role flagged
    // `ekonomi`; the flat email mirror lives ONLY in private/access. Grants
    // member-level read plus the paidRefs-only registration update below.
    function isEkonomi(cid) {
      return isSignedIn() && accessExists(cid)
        && authEmail() in accessData(cid).get('ekonomiEmails', []);
    }

    function isCompMember(cid) {
      return isCompAdmin(cid)
        || (isSignedIn() && authEmail() in compData(cid).get('userEmails', []))
        || (isSignedIn() && accessExists(cid) && authEmail() in accessData(cid).get('userEmails', []))
        || isEkonomi(cid);
    }

    // A competition flagged with demo: true is read-only for everyone except
    // super-admins. Used for the bundled "Demospår" that ships in prod so new
    // users can explore without being able to deface it.
    // NOTE: must use .get() with a default — competitions created without the
    // demo field would otherwise make this expression ERROR (reading a missing
    // property is an evaluation error in rules), which denied every anonymous
    // score/registration write on those competitions.
    function compIsDemo(cid) {
      return compData(cid).get('demo', false) == true;
    }

    // A closed (avslutad) competition is read-only for everyone but admins.
    function compClosed(cid) {
      return compData(cid).get('closed', false) == true;
    }

    function registrationEnabled(cid) {
      return compData(cid).get('registration', {}).get('enabled', false) == true;
    }

    // Control doc for score validation — fetched once and passed to the
    // shape check so we don't spend multiple get()s per rule evaluation.
    function ctrlData(cid, ctrlId) {
      return get(/databases/$(database)/documents/competitions/$(cid)/controls/$(ctrlId)).data;
    }

    // ansvarigaEmails is being moved from the control doc into its private/meta
    // subdoc (Fas 3). Read a union of both during the migration.
    function ctrlMetaExists(cid, ctrlId) {
      return exists(/databases/$(database)/documents/competitions/$(cid)/controls/$(ctrlId)/private/meta);
    }
    function ctrlMetaData(cid, ctrlId) {
      return get(/databases/$(database)/documents/competitions/$(cid)/controls/$(ctrlId)/private/meta).data;
    }
    function isCtrlAnsvarig(cid, ctrlId) {
      return isSignedIn() && (
        authEmail() in ctrlData(cid, ctrlId).get('ansvarigaEmails', [])
        || (ctrlMetaExists(cid, ctrlId) && authEmail() in ctrlMetaData(cid, ctrlId).get('ansvarigaEmails', []))
      );
    }

    // Shape/bounds check for an ANONYMOUS score write, given the already
    // fetched control data `c`. Enforces: control open, doc-id == patrolId,
    // point value within the control's [min,max], extra within [0,extra],
    // types, allowed keys, short note. Admins bypass this entirely.
    function anonScoreShape(c, scoreId, data) {
      return c.get('open', false) == true
        && scoreId == data.patrolId
        && data.patrolId is string
        && data.poang is number
        && data.poang >= c.get('minPoang', 0)
        && data.poang <= c.get('maxPoang', 100000)
        && (!('extraPoang' in data) || (data.extraPoang is number && data.extraPoang >= 0 && data.extraPoang <= c.get('extraPoang', 0)))
        && (!('utslagGissning' in data) || data.utslagGissning is number)
        && (!('note' in data) || (data.note is string && data.note.size() <= 500))
        && (!('clientReportedAt' in data) || data.clientReportedAt is timestamp)
        // reporter är ett kort pseudonymt enhets-id — utan tak vore det en
        // ostryparad textkanal (upp till Firestores 1 MB) som varje läsning
        // av score-dokumentet betalar för. (history behöver ingen vakt här —
        // create/update-reglerna nedan kräver redan tom/oförändrad history.)
        && (!('reporter' in data) || (data.reporter is string && data.reporter.size() <= 100))
        && data.keys().hasOnly(['patrolId','poang','extraPoang','note','reportedAt','clientReportedAt','reporter','utslagGissning','history']);
    }

    // --- Tävlingsförfrågningar
    // En inloggad användare kan inte skapa en tävling själv (se competitions
    // create) utan skickar en förfrågan med grunduppgifter + ett meddelande.
    // Super-admins får listan, godkänner eller nekar med ett svar tillbaka,
    // och det är godkännandet som skapar tävlingen med sökanden som admin.
    // En Cloud Function mailar super-admins vid ny förfrågan och sökanden
    // vid beslut (reagerar på create/update här — klienten rör aldrig /mail).
    //
    // Läsning: super-admin ser alla; sökanden ser sina egna (klienten frågar
    // med where('requestedBy','==',uid), vilket regeln nedan validerar per
    // dokument — en obegränsad list nekas för alla utom super-admin).
    match /competitionRequests/{reqId} {
      allow read: if isSuperAdmin()
        || (isSignedIn() && resource.data.requestedBy == request.auth.uid);

      // Högst TRE förfrågningar per konto, framtvingat via dokument-id:t:
      // "<uid>-0|1|2". Rules kan inte räkna dokument, men create nekas på ett
      // id som redan finns — alltså är tre platser ett hårt tak. Sökanden
      // frigör en plats genom att dölja en behandlad förfrågan.
      allow create: if isSignedIn()
        && reqId.matches('^' + request.auth.uid + '-[0-2]$')
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.requestedByEmail == authEmail()
        && request.resource.data.status == 'vantar'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.get('description', '') is string
        && request.resource.data.get('description', '').size() <= 2000
        && request.resource.data.get('message', '') is string
        && request.resource.data.get('message', '').size() <= 2000
        && (request.resource.data.get('date', null) == null
            || (request.resource.data.date is string && request.resource.data.date.size() <= 10))
        && request.resource.data.district is string
        && request.resource.data.district.size() > 0
        && request.resource.data.district.size() <= 40
        && request.resource.data.keys().hasOnly([
             'name', 'description', 'date', 'message', 'district',
             'requestedBy', 'requestedByEmail', 'status', 'createdAt'
           ]);

      // Beslutet (status/svar/competitionId) sätts bara av super-admin.
      allow update: if isSuperAdmin();

      // Super-admin städar; sökanden får rensa bort sin egen behandlade
      // förfrågan (kvittera ett nej) men inte radera en som väntar på svar.
      allow delete: if isSuperAdmin()
        || (isSignedIn()
            && resource.data.requestedBy == request.auth.uid
            && resource.data.status != 'vantar');
    }

    // --- Meddelanden till ESKIL (kontaktformuläret på /kontakt) ------------
    // Dokumentet SKAPAS aldrig av en klient: formuläret går via den anropbara
    // funktionen sendFeedback, som stryper per adress och mot dygnskvoten
    // innan admin-SDK:n skriver. Rules kan inte räkna anrop, och en anonymt
    // skrivbar toppnivåkollektion vore en öppen kran rakt in i databasen.
    //
    // ID:T ÄR HEMLIGHETEN, precis som för anmälningarnas ändringslänk:
    // avsändaren får `/kontakt/<fbId>` i svarsmailet och kan läsa tråden och
    // svara där. Därför får det HÄR dokumentet bara innehålla sådant
    // avsändaren själv skrivit — regler kan inte dölja enskilda fält, så
    // allt som är internt (vilken super-admin som svarat, om avsändaren var
    // inloggad) ligger i private/meta nedan.
    match /feedback/{fbId} {
      // get, inte read: `read` täcker även `list`, och då hade vem som helst
      // kunnat räkna upp HELA kollektionen — alla andras meddelanden och
      // adresser. Att känna till id:t är att hålla den hemliga länken.
      allow get: if true;
      allow list: if isSuperAdmin();
      // Handläggningen sätts av super-admin. faltReadAt får avsändaren
      // stämpla själv — den säger bara att tråden är öppnad.
      allow update: if isSuperAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'lastAt', 'lastFrom', 'replyCount']);
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['faltReadAt']);
      allow create, delete: if false;

      // Det interna: vilken super-admin som hanterat ärendet och om
      // avsändaren var inloggad. Aldrig läsbart för den som har länken —
      // hela poängen med att svara i ESKIL är att super-adminens adress
      // inte lämnar systemet.
      match /private/{doc} {
        allow read, write: if isSuperAdmin();
      }

      // Samtalet. Båda hållen skriver hit; en Cloud Function mailar vidare —
      // svaret till avsändaren FRÅN ESKIL, en följdfråga till super-admins.
      match /messages/{msgId} {
        allow read: if true;
        allow create: if request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 4000
          && request.resource.data.at is timestamp
          && request.resource.data.keys().hasOnly(['from', 'text', 'at'])
          && (
            // Super-admin svarar.
            (isSuperAdmin() && request.resource.data.from == 'eskil')
            // Avsändaren skriver igen — men bara så länge ärendet är öppet.
            // Ett avslutat ärende tar inte emot mer; då hänvisas hen till
            // formuläret, och länken kan inte användas för att mata ut mail.
            || (request.resource.data.from == 'anvandare'
                && get(/databases/$(database)/documents/feedback/$(fbId)).data.status != 'stangd')
          );
        // Ett skickat meddelande är skickat. Det ligger redan i någons inkorg.
        allow update, delete: if false;
      }
    }

    // --- System config (super-admin only). Operational settings tunable
    // without a deploy (e.g. mail rate-limit caps). Cloud Functions read it
    // via the admin SDK (bypassing rules).
    match /config/{doc} {
      allow read, write: if isSuperAdmin();
    }

    // --- Users
    // Any signed-in user may read the (email, role) of other users so that
    // competition admins can look up invitees by email. A user may only
    // create/update their own doc, and cannot elevate their own role — only
    // the pre-approved super-admin email may self-assign "super-admin".
    match /users/{uid} {
      // Own doc + super-admin only — a regular user must not be able to
      // enumerate every account's email/role.
      allow read: if isSignedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow create: if isSignedIn() && request.auth.uid == uid
        && (
          request.resource.data.role == 'user'
          || (request.resource.data.role == 'super-admin'
              // MUST match SUPER_ADMIN_EMAIL in public/js/store.js
              && request.auth.token.email == 'johan@leitet.se')
        );
      allow update: if isSuperAdmin()
        || (isSignedIn() && request.auth.uid == uid
            && request.resource.data.role == resource.data.role);
      allow delete: if isSuperAdmin();
    }

    // --- Competitions
    match /competitions/{cid} {
      allow read: if true; // public read of competition meta is OK (names only)
      // Tävlingar skapas INTE fritt: en vanlig användare skickar en förfrågan
      // (competitionRequests nedan) som en super-admin godkänner, och det är
      // super-adminens klient som skapar dokumentet. Undantaget är
      // årgångskopiering — den som redan är admin på en tävling får kopiera
      // den till nästa år utan att gå via förfrågan (copiedFrom pekar på
      // ursprungstävlingen och måste vara en tävling hen administrerar).
      // OBS: läs alltid optionella fält med .get() — en direktläsning av en
      // saknad property är ett evaluation ERROR som nekar skrivningen.
      allow create: if isSuperAdmin()
        || (isSignedIn()
            && request.resource.data.get('demo', false) != true
            && request.resource.data.get('copiedFrom', '') is string
            && request.resource.data.get('copiedFrom', '') != ''
            && isCompAdmin(request.resource.data.copiedFrom));
      // Writes on a demo competition are locked to super-admin.
      allow update: if isSuperAdmin()
        || (isCompAdmin(cid) && !compIsDemo(cid));
      allow delete: if isSuperAdmin();

      // Member-only permission/PII mirror (Fas 3): adminEmails, userEmails,
      // admins, users, and (later) management. The rules read it via get()
      // in isCompAdmin/isCompMember; members read it to see the member list.
      match /private/{doc} {
        allow read: if isCompMember(cid);
        allow write: if isSuperAdmin() || (isCompAdmin(cid) && !compIsDemo(cid));
      }

      // Papperskorgen. Bär hela dokumentet OCH dess poäng — patrullnamn, kår,
      // noteringar, telefonnummer. Enbart admin, aldrig anonymt och aldrig
      // medlem: en raderad patrull ska inte vara läsbarare än en levande.
      // Tömms av closeCompetition (GDPR) och deleteCompetition.
      match /papperskorg/{korgId} {
        allow read, write: if isSuperAdmin() || isCompAdmin(cid);
      }

      // Sekretariatets logg. Vem stängde kontrollen, vem tog bort patrullen,
      // vem ändrade maxtiden — det saknade spår helt, och dagen efter minns
      // ingen. Loggen namnger patruller och bär ledningens anteckningar, så
      // `list` är member-only; `read` hade täckt både get och list och gjort
      // hela kollektionen uppräkningsbar.
      //
      // APPEND-ONLY, men inte via `allow update, delete: if false` — då kunde
      // varken closeCompetition eller deleteCompetition sopa den, och loggen
      // hade överlevt tävlingen den handlar om. Admin får radera (gallring),
      // ingen får skriva om en befintlig post.
      match /logg/{loggId} {
        allow get, list: if isCompMember(cid);
        allow create: if isCompMember(cid) && !compIsDemo(cid)
          && request.resource.data.at is timestamp
          && request.resource.data.at <= request.time + duration.value(2, 'm')
          && request.resource.data.av is string
          && request.resource.data.av.size() <= 120
          && request.resource.data.vad is string
          && request.resource.data.vad.size() <= 60
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 500
          && request.resource.data.keys().hasOnly(['at', 'av', 'vad', 'text']);
        allow update: if false;
        allow delete: if isSuperAdmin() || isCompAdmin(cid);
      }

      // Patrols — readable by anyone (ID is obscure anyway, used by control page)
      match /patrols/{pid} {
        allow read: if true;
        allow write: if isSuperAdmin() || (isCompAdmin(cid) && !compIsDemo(cid));

        // Internal meta (notering) — NOT public. Members read/admins write.
        match /private/{doc} {
          allow read: if isCompMember(cid);
          allow write: if isSuperAdmin() || (isCompAdmin(cid) && !compIsDemo(cid));
        }
      }

      // Controls — read public (ID is the secret). Create/delete by admins;
      // update also by the control's kontrollansvariga (email match), who may
      // edit everything EXCEPT the ansvariga lists themselves (no adding
      // friends / privilege changes) and only while the competition is open.
      match /controls/{ctrlId} {
        allow read: if true;
        allow create: if isSuperAdmin() || (isCompAdmin(cid) && !compIsDemo(cid));
        allow delete: if isSuperAdmin() || (isCompAdmin(cid) && !compIsDemo(cid));
        allow update: if isSuperAdmin()
          || (isCompAdmin(cid) && !compIsDemo(cid))
          || (
               isSignedIn()
            && !compIsDemo(cid)
            && !compClosed(cid)
            && (authEmail() in resource.data.get('ansvarigaEmails', [])
                || (ctrlMetaExists(cid, ctrlId) && authEmail() in ctrlMetaData(cid, ctrlId).get('ansvarigaEmails', [])))
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['ansvariga', 'ansvarigaEmails'])
          );

        // Scores — anonymous create/update allowed if control is open AND the
        // competition isn't a demo. Super-admin can always seed scores.
        // Kontrollens livstecken — rapportsidan skriver ett litet hjärtslag
        // medan den är öppen: senaste livstecknet (klient-tid, så en buffrad
        // offline-skrivning bär SANN senast-vid-liv-tid), batterinivå och
        // antalet köade offline-poäng. Läget kan då skilja "tyst för att inga
        // patruller kommit" från "telefonen håller på att dö", och ser köade
        // poäng som annars är osynliga i EN telefons localStorage.
        // Anonym skrivning (rapportsidan är anonym; kontroll-id:t är
        // hemligheten och kontrollen måste vara öppen), hårt formad.
        // Läsning är MEMBER-only: batteri- och könivå är intern drift.
        match /beacon/{beaconDoc} {
          // Demo: livstecken-kolumnen i Läget ("telefonen på kontroll 7 har
          // 11 % kvar") är en av vyns bästa säljpunkter och bär ingen
          // persondata — bara batteri, kö och en tidsstämpel.
          allow read: if isCompMember(cid) || compIsDemo(cid);
          allow write: if !compIsDemo(cid)
            && ctrlData(cid, ctrlId).get('open', false) == true
            && beaconDoc.size() <= 64
            && request.resource.data.at is timestamp
            // Tidsspärr som på selfPassages: `at` är klient-tid (så ett
            // offline-buffrat livstecken bär rätt tidpunkt), men utan gräns
            // kan den som har den hemliga länken skriva ett `at` långt fram i
            // tiden — kontrollen ser då för evigt ut att just ha hörts av,
            // och Läget slutar larma om en kontroll som faktiskt är tyst.
            && request.resource.data.at >= request.time - duration.value(12, 'h')
            && request.resource.data.at <= request.time + duration.value(2, 'm')
            && (!('batteri' in request.resource.data)
                || (request.resource.data.batteri is number
                    && request.resource.data.batteri >= 0
                    && request.resource.data.batteri <= 100))
            && (!('laddar' in request.resource.data) || request.resource.data.laddar is bool)
            && (!('koade' in request.resource.data)
                || (request.resource.data.koade is int
                    && request.resource.data.koade >= 0
                    && request.resource.data.koade <= 1000))
            && request.resource.data.keys().hasOnly(['at', 'batteri', 'laddar', 'koade']);
          allow delete: if isSuperAdmin() || (isCompAdmin(cid) && !compIsDemo(cid));
        }

        match /scores/{scoreId} {
          allow read: if true;
          // Admins may always write scores (adjustments, backup restore).
          // Anonymous reporters: only while the control is open, with a
          // validated shape/bounds, doc-id bound to patrolId, and NO
          // ability to introduce or alter the (admin-authored) history trail.
          allow create: if isSuperAdmin() || (isCompAdmin(cid) && !compIsDemo(cid)) || (
               !compIsDemo(cid)
            && anonScoreShape(ctrlData(cid, ctrlId), scoreId, request.resource.data)
            && (!('history' in request.resource.data) || request.resource.data.history.size() == 0)
          );
          allow update: if isSuperAdmin() || (isCompAdmin(cid) && !compIsDemo(cid)) || (
               !compIsDemo(cid)
            && anonScoreShape(ctrlData(cid, ctrlId), scoreId, request.resource.data)
            && request.resource.data.get('history', []) == resource.data.get('history', [])
          );
          // Rapportsidans "Ta bort rapport" är anonym — kontrollanten som
          // råkade trycka på fel patrull har ingen inloggning. Utan den här
          // grenen NEKADES borttagningen: online syntes ett kryptiskt
          // rättighetsfel, och offline tog Firestore bort dokumentet lokalt,
          // sa "Borttagen" och rullade tillbaka det vid synk — poängen kom
          // tillbaka utan att någon fick veta det.
          // Samma grindar som create: kontrollen måste vara öppen (samma
          // hemlighet som styr rapporteringen), aldrig demo. Ett dokument med
          // admin-historik lämnas i fred — rättelsespåret får inte gå att
          // radera bort anonymt.
          allow delete: if isSuperAdmin() || (isCompAdmin(cid) && !compIsDemo(cid)) || (
               !compIsDemo(cid)
            && ctrlData(cid, ctrlId).get('open', false) == true
            && scoreId == resource.data.patrolId
            && resource.data.get('history', []).size() == 0
          );
        }

        // Internal/personal control meta (telefon, notering, ansvariga) — NOT
        // public. Read by members OR this control's kontrollansvarig; written
        // by admins OR the kontrollansvarig.
        //
        // A kontrollansvarig may edit telefon/notering AND invite co-ansvariga
        // to their own control — but APPEND-ONLY: the new ansvarigaEmails must
        // contain every existing entry (hasAll), so nobody can be removed and
        // the control can never be taken over. Removal stays admin-only, and
        // `welcomed` (the welcome-mail ledger) plus `threadToken` (samtalstoken
        // — den ligger i tryckta QR-koder; kunde en ansvarig skriva om den
        // dog kontrollens fältlänk tyst mitt i tävlingen) stay client-immutable.
        match /private/{doc} {
          // Demo: utan den här grenen står TELEFON-kolumnen tom i Läget, i
          // kontrollistan och i fältkortens nödinfo, och /k-länken saknar
          // samtalsnyckel. Demospårets meta bär bara påhittade 070-000-nummer
          // och example.se-adresser.
          allow read: if isCompMember(cid) || isCtrlAnsvarig(cid, ctrlId) || compIsDemo(cid);
          allow create: if isSuperAdmin() || (isCompAdmin(cid) && !compIsDemo(cid))
            || (!compIsDemo(cid) && !compClosed(cid) && isCtrlAnsvarig(cid, ctrlId)
                && !request.resource.data.keys().hasAny(['welcomed', 'threadToken'])
                && (!request.resource.data.keys().hasAny(['ansvariga', 'ansvarigaEmails'])
                    || request.resource.data.get('ansvarigaEmails', [])
                         .hasAll(ctrlData(cid, ctrlId).get('ansvarigaEmails', []))));
          allow update: if isSuperAdmin() || (isCompAdmin(cid) && !compIsDemo(cid))
            || (!compIsDemo(cid) && !compClosed(cid) && isCtrlAnsvarig(cid, ctrlId)
                && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['welcomed', 'threadToken'])
                && request.resource.data.get('ansvarigaEmails', [])
                     .hasAll(resource.data.get('ansvarigaEmails', [])));
        }
      }

      // Spårdragning — the course polylines drawn in the Spår editor. One
      // doc ("main") holding waypoints per leg. Same visibility as controls
      // (which already expose every position publicly); only admins draw.
      match /track/{docId} {
        allow read: if true;
        allow write: if isSuperAdmin() || (isCompAdmin(cid) && !compIsDemo(cid));
      }

      // Samtal fält ↔ tävlingsledning. En tråd per kontroll och per patrull,
      // med DETERMINISTISKT id: "kontroll-<ctrlId>" / "patrull-<patrolId>".
      // Att känna till tråd-id:t är alltså detsamma som att hålla den hemliga
      // fältlänken — samma trustmodell som poängrapportering.
      //
      // Bilderna ligger i meddelandet som data-URL, inte i Cloud Storage:
      // projektet har ingen Storage-bucket, och en bild från skogen kan visa
      // scouters ansikten. I Firestore följer den tävlingens gallring.
      // Storleken vaktas HÄR — utan tak kan en anonym sida fylla databasen.
      match /threads/{threadId} {
        function faltFar() {
          return !compIsDemo(cid) && !compClosed(cid)
            && compData(cid).get('fieldMessaging', true) == true;
        }
        function refFinns(kind, refId) {
          return (kind == 'kontroll' && exists(/databases/$(database)/documents/competitions/$(cid)/controls/$(refId)))
              || (kind == 'patrull'  && exists(/databases/$(database)/documents/competitions/$(cid)/patrols/$(refId)));
        }
        // Formen på ett trådhuvud skrivet FRÅN FÄLTET.
        //
        // lastFrom-kravet har en undantagsgren, och den är inte kosmetisk:
        // fältets läskvittens (faltReadAt) skrivs med merge, så det FÄRDIGA
        // dokumentet bär lastFrom 'ledning' — precis den enda gång kvittensen
        // körs, nämligen när ledningen svarat sist. Utan undantaget nekades
        // varje kvittens, felet slukades av .catch() i chat.js och oläst-pricken
        // på /k och /s slocknade aldrig. Mätt i emulatorn.
        function faltHuvudForm() {
          return request.resource.data.keys().hasOnly(['kind', 'refId', 'lastAt', 'lastFrom', 'lastText', 'faltReadAt', 'ledningReadAt'])
            && request.resource.data.kind in ['kontroll', 'patrull']
            && request.resource.data.refId is string
            && request.resource.data.refId.size() > 0
            && request.resource.data.refId.size() <= 64
            && refFinns(request.resource.data.kind, request.resource.data.refId)
            && (request.resource.data.get('lastFrom', '') == 'falt'
                || (resource != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['faltReadAt'])));
        }

        // TRÅD-ID:T ÄR ANTINGEN HÄRLETT ELLER EN TOKEN, och skillnaden avgör vem
        // som får LÄSA. Den härledda formen ('kontroll-<ctrlId>') går att räkna
        // fram ur publikt läsbara kontroll- och patrulldokument — den var därför
        // ingen hemlighet alls, och med `allow get: if true` kunde vem som helst
        // läsa fältets samtal med ledningen: nödropens GPS-position och
        // bilderna från skogen. Tokenformen mintas av ledningen, ligger bara i
        // fältlänken och i member-only meta, och kan inte räknas fram.
        //
        // SKRIVNING lämnas medvetet öppen på BÅDA formerna. Nödropet på
        // startkortet har EN enda kanal (start.js) och tävlingssidan länkar
        // publikt till startkorten, så de flesta patruller står utan token —
        // krävdes token för att skriva vore nödropet dött för dem. Att kunna
        // skicka utan att kunna läsa är hela poängen: fältet blir aldrig
        // avstängt från ledningen, men samtalet går inte att tjuvlyssna på.
        // (?s) så att punkten matchar ÄVEN radbrytning. Utan flaggan skulle ett
        // id som 'kontroll-<något med \n>' falla ur den härledda formen och
        // behandlas som en token — alltså bli läsbart för alla. Dokument-id:n
        // får innehålla radbrytning, så det är inte teoretiskt.
        function harledd() {
          return threadId.matches('(?s)^(kontroll|patrull)-.*');
        }

        // DEMOSPÅRET SER ALLT. En demotävling kan bara skapas av en super-admin
        // och innehåller uteslutande seedad påhittad data — inga riktiga namn,
        // adresser eller positioner. Utan den här grenen är hela samtalet
        // fält↔ledning osynligt i det kontofria demot, och det är en av de
        // funktioner en scoutkår mest behöver se innan de väljer system.
        // Grenen hänger på compIsDemo, ALDRIG på ett tävlings-id.
        allow get: if isCompMember(cid) || compIsDemo(cid) || !harledd();
        // list bara för medlemmar — annars går både kontroll-id:n och tokens
        // att räkna upp.
        allow list: if isCompMember(cid) || compIsDemo(cid);

        // Fältet får BARA skapa den härledda tråden. Kunde det skapa en tråd
        // med valfritt id vore tokenformen värdelös — vem som helst kunde lägga
        // upp ett id, göra det läsbart och sedan läsa det. Tokentrådens huvud
        // skapas av ledningen när token mintas.
        allow create: if isCompAdmin(cid) || (
             faltFar()
          && harledd()
          && faltHuvudForm()
          && threadId == request.resource.data.kind + '-' + request.resource.data.refId
          && !('ledningReadAt' in request.resource.data)
        );
        allow update: if isCompAdmin(cid) || (
             faltFar()
          && faltHuvudForm()
          && (harledd()
              // Härledd tråd: id:t MÅSTE fortsätta matcha sin referens.
              ? threadId == request.resource.data.kind + '-' + request.resource.data.refId
              // Tokentråd: huvudet finns redan (ledningen skapade det), och
              // fältet får inte peka om det till en annan kontroll/patrull —
              // då hamnar samtalet under fel namn i inkorgen.
              : (resource != null
                 && request.resource.data.kind == resource.data.kind
                 && request.resource.data.refId == resource.data.refId))
          // Fältet får aldrig röra ledningens läskvittens — då skulle ett
          // inkommet meddelande kunna gömmas för sekretariatet.
          && request.resource.data.get('ledningReadAt', null) == resource.data.get('ledningReadAt', null)
        );
        allow delete: if isSuperAdmin() || (isCompAdmin(cid) && !compIsDemo(cid));

        match /messages/{msgId} {
          // Samma delning som på huvudet: härledd tråd = member-only, tokentråd
          // = den som håller fältlänken. Det är HÄR nödropen och bilderna
          // ligger, så det är den här raden som stänger läckan.
          allow read: if isCompMember(cid) || compIsDemo(cid) || !harledd();
          // Anonymt: BARA från fältet. Ett anonymt meddelande som utger sig
          // för att komma från ledningen vore ett sätt att lura kontrollanter.
          allow create: if isCompAdmin(cid) || (
               faltFar()
            && request.resource.data.keys().hasOnly(['from', 'text', 'at', 'image'])
            && request.resource.data.from == 'falt'
            && request.resource.data.at is timestamp
            && request.resource.data.at <= request.time + duration.value(2, 'm')
            && request.resource.data.at >= request.time - duration.value(12, 'h')
            && (!('text' in request.resource.data)
                || (request.resource.data.text is string && request.resource.data.text.size() <= 2000))
            && (!('image' in request.resource.data)
                || (request.resource.data.image is string
                    && request.resource.data.image.size() <= 400000
                    && request.resource.data.image.matches('^data:image/(jpeg|png|webp);base64,.*')))
            && (('text' in request.resource.data) || ('image' in request.resource.data))
            // I en tokentråd måste huvudet redan finnas: det är beviset för att
            // ledningen mintat just den token. Utan kravet kunde vem som helst
            // skriva meddelanden under ett påhittat id och sedan läsa dem.
            && (harledd() || exists(/databases/$(database)/documents/competitions/$(cid)/threads/$(threadId)))
          );
          // Skrivet är skrivet — ett samtal med sekretariatet ska inte gå att
          // skriva om i efterhand. Admin kan rensa.
          allow update: if isCompAdmin(cid) && !compIsDemo(cid);
          allow delete: if isSuperAdmin() || (isCompAdmin(cid) && !compIsDemo(cid));
        }
      }

      // Patrullens egna avprickningar — "Bekräfta start" och "Vi är i mål" på
      // startkortet (/s/<cid>/<patrolId>), i stället för en funktionär vid
      // start/mål. Egen collection eftersom startkortet INTE känner till
      // stations-id:t (det är hemligt, och den som har det kan checka in/ut
      // alla patruller). Läget och stationssidan slår ihop de här med
      // stationens passages till en bild.
      //
      // Varje stämpel sätts EN gång och kan sedan inte flyttas: startkorts-
      // länken sprids i patrullen, och en tid som går att skriva om är inget
      // facit för sekretariatet. Ångra är en admin-åtgärd.
      //
      // Tidsfönstret hindrar uppenbart påhittade tider. Att starten inte får
      // bekräftas FÖRE patrullens starttid, och målet inte före sista
      // kontrollen, vaktas i gränssnittet — reglerna kan varken räkna fram
      // startordning × intervall eller läsa alla poängdokument.
      match /selfPassages/{patrolId} {
        function inWindow(ts) {
          return ts is timestamp
            && ts <= request.time + duration.value(2, 'm')
            && ts >= request.time - duration.value(12, 'h');
        }
        function flagOn(flag) { return compData(cid).get(flag, false) == true; }
        function baseOk() {
          return !compIsDemo(cid) && !compClosed(cid)
            && request.resource.data.keys().hasOnly(['patrolId', 'startAt', 'finishAt'])
            && request.resource.data.patrolId == patrolId
            && exists(/databases/$(database)/documents/competitions/$(cid)/patrols/$(patrolId));
        }

        allow read: if true;

        allow create: if isCompAdmin(cid) || (
             baseOk()
          && (!('startAt'  in request.resource.data) || (flagOn('selfStart')  && inWindow(request.resource.data.startAt)))
          && (!('finishAt' in request.resource.data) || (flagOn('selfFinish') && inWindow(request.resource.data.finishAt)))
        );

        // Ett fält som redan har ett värde måste följa med OFÖRÄNDRAT; ett
        // tomt fält får fyllas i om dess funktion är påslagen.
        allow update: if isCompAdmin(cid) || (
             baseOk()
          && (('startAt' in resource.data)
                ? request.resource.data.get('startAt', null) == resource.data.startAt
                : (!('startAt' in request.resource.data) || (flagOn('selfStart') && inWindow(request.resource.data.startAt))))
          && (('finishAt' in resource.data)
                ? request.resource.data.get('finishAt', null) == resource.data.finishAt
                : (!('finishAt' in request.resource.data) || (flagOn('selfFinish') && inWindow(request.resource.data.finishAt))))
        );

        allow delete: if isSuperAdmin() || (isCompAdmin(cid) && !compIsDemo(cid));
      }

      // Start/Mål-station — the station doc ID is the secret in the station
      // URL (/m/<cid>/<stationId>), same trust model as reporter links. The
      // station crew checks patrols out at start and in at mål; passages hold
      // one doc per patrol with server timestamps. Anyone holding the link
      // may write passages while the competition is open; list is member-only
      // so the secret can't be enumerated anonymously.
      match /stations/{stationId} {
        allow get: if true;
        // list is member-only so secret station ids can't be enumerated —
        // except on demo competitions, where the account-free demo mode
        // shows the station card on Läget (check-ins are blocked anyway).
        allow list: if isCompMember(cid) || compIsDemo(cid);
        allow create, update, delete: if isSuperAdmin() || (isCompAdmin(cid) && !compIsDemo(cid));

        match /passages/{patrolId} {
          allow read: if true;
          allow create: if isCompAdmin(cid) || (
               !compIsDemo(cid) && !compClosed(cid)
            && request.resource.data.keys().hasOnly(['patrolId', 'startAt', 'finishAt'])
            && request.resource.data.patrolId == patrolId
            && (!('startAt' in request.resource.data) || request.resource.data.startAt is timestamp)
            && (!('finishAt' in request.resource.data) || request.resource.data.finishAt is timestamp)
          );
          allow update: if isCompAdmin(cid) || (
               !compIsDemo(cid) && !compClosed(cid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['startAt', 'finishAt'])
            && request.resource.data.patrolId == patrolId
            && (!('startAt' in request.resource.data) || request.resource.data.startAt is timestamp)
            && (!('finishAt' in request.resource.data) || request.resource.data.finishAt is timestamp)
          );
          allow delete: if isSuperAdmin() || (isCompAdmin(cid) && !compIsDemo(cid));
        }
      }

      // Meddelanden (broadcast v2) — parallella driftmeddelanden från
      // ledningen till fältsidorna. Publikt läsbara (fältsidorna är anonyma —
      // composern varnar för personuppgifter), admin-skrivna. Varje meddelande
      // kan begära bekräftelse: klienterna skriver då kvittensdokument i
      // acks/ — anonymt (samma trustmodell som poängrapporter) men med hårt
      // validerad form och deterministiskt doc-id (<kind>-<refId>) så
      // omkvittering skriver över i stället för att växa. Acks får BARA läsas
      // av medlemmar: kvittenserna innehåller stations-id (hemligt) och ska
      // inte gå att enumerera anonymt.
      match /messages/{msgId} {
        allow read: if true;
        allow create, update, delete: if isSuperAdmin() || (isCompAdmin(cid) && !compIsDemo(cid));

        // Anonyma kvittenser är hårt grindade:
        //  - föräldermeddelandet måste finnas, vara aktivt och kräva
        //    bekräftelse (get() på saknat dokument fel-terminerar = deny,
        //    vilket också stoppar föräldralösa spam-dokument under påhittade
        //    meddelande-id:n),
        //  - refId måste vara ett EXISTERANDE kontroll-/patrull-/stations-
        //    dokument (binder dokumentrymden; stations-id är dessutom
        //    hemligt så stations-kvittenser kan inte förfalskas),
        //  - stämplarna är append-only (en befintlig seenAt/ackAt kan aldrig
        //    ändras eller raderas anonymt — samma princip som poäng-history)
        //    och får inte vara daterade i framtiden.
        // Kvarstående, medveten lucka: kontroll-/patrull-id:n är publikt
        // läsbara (anonyma sidor kräver det), så en kvittens KAN förfalskas
        // för en existerande mottagare — UI:t presenterar därför kvittenser
        // som lägesbild, inte facit.
        match /acks/{ackId} {
          allow read: if isCompMember(cid);
          allow create, update: if isSuperAdmin() || (isCompAdmin(cid) && !compIsDemo(cid)) || (
               !compIsDemo(cid) && !compClosed(cid)
            && get(/databases/$(database)/documents/competitions/$(cid)/messages/$(msgId)).data.get('requireAck', false) == true
            && get(/databases/$(database)/documents/competitions/$(cid)/messages/$(msgId)).data.get('active', false) == true
            && ackId == request.resource.data.kind + '-' + request.resource.data.refId
            && request.resource.data.kind in ['kontroll', 'patrull', 'station']
            && request.resource.data.refId is string
            && request.resource.data.refId.size() > 0
            && request.resource.data.refId.size() <= 64
            && (
                 (request.resource.data.kind == 'kontroll' && exists(/databases/$(database)/documents/competitions/$(cid)/controls/$(request.resource.data.refId)))
              || (request.resource.data.kind == 'patrull'  && exists(/databases/$(database)/documents/competitions/$(cid)/patrols/$(request.resource.data.refId)))
              || (request.resource.data.kind == 'station'  && exists(/databases/$(database)/documents/competitions/$(cid)/stations/$(request.resource.data.refId)))
            )
            && request.resource.data.keys().hasOnly(['kind', 'refId', 'seenAt', 'ackAt'])
            && (!('seenAt' in request.resource.data) || (request.resource.data.seenAt is timestamp && request.resource.data.seenAt < request.time + duration.value(5, 'm')))
            && (!('ackAt' in request.resource.data) || (request.resource.data.ackAt is timestamp && request.resource.data.ackAt < request.time + duration.value(5, 'm')))
            && (resource == null || !('seenAt' in resource.data) || request.resource.data.get('seenAt', null) == resource.data.seenAt)
            && (resource == null || !('ackAt' in resource.data) || request.resource.data.get('ackAt', null) == resource.data.ackAt)
          );
          allow delete: if isSuperAdmin() || (isCompAdmin(cid) && !compIsDemo(cid));
        }
      }

      // Registrations (Anmälan) — the doc ID is the secret manage link, same
      // trust model as control reporter URLs. Anyone holding the link may read
      // and update their registration while registration is enabled; only
      // competition members may list all registrations. Period enforcement
      // (open/closed dates) is handled in the UI by design.
      match /registrations/{regId} {
        allow get: if true;
        // Demo: Anmälan-fliken var en död återvändsgränd — listan är
        // member-only, så en demobesökare fick "Kunde inte ladda" rakt i
        // ansiktet. Samma mönster som stations redan har. Demospårets
        // anmälningar är påhittade kårer med example.se-adresser.
        allow list: if isCompMember(cid) || compIsDemo(cid);
        // Anonymous manage-link holders may only touch participant fields.
        // Payment status lives in the admin-only `paidRefs` array (see
        // isPaymentPaid), and the admin stamps reminder*/imported — none of
        // which a non-admin can create or change. hasOnly on create, and
        // affectedKeys on update so admin-added fields don't lock out the
        // registrant's own later edits.
        allow create: if isCompAdmin(cid) || (
             registrationEnabled(cid) && !compIsDemo(cid) && !compClosed(cid)
          && request.resource.data.keys().hasOnly(['kar','contact','patrols','answers','mode','totalAmount','payments','cancelled','forhinder','createdAt','updatedAt'])
        );
        allow update: if isCompAdmin(cid) || (
          // Ekonomiansvarig ticks payments off: may touch ONLY the
          // authoritative paidRefs array — no participant data, no amounts.
             isEkonomi(cid) && !compIsDemo(cid) && !compClosed(cid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paidRefs'])
        ) || (
          // Länkinnehavaren. `paymentClaims` är anmälarens PÅSTÅENDE om att en
          // betalning är gjord — aldrig ett facit. `paidRefs` står medvetet
          // INTE i listan nedan: den är kassörens sanning, och uppdelningen ÄR
          // skyddet. Lägg aldrig till paidRefs här.
             registrationEnabled(cid) && !compIsDemo(cid) && !compClosed(cid)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['kar','contact','patrols','answers','mode','totalAmount','payments','cancelled','forhinder','paymentClaims','andringar','kompletteringar','updatedAt'])
          && request.resource.data.get('kompletteringar', []) is list
          && request.resource.data.get('kompletteringar', []).size() <= 40
          // Ändringsförfrågningar efter stängd anmälan. Samma .get()-med-default
          // som paymentClaims: en direktläsning på en anmälan utan fältet är ett
          // evalueringsFEL som tyst nekar HELA redigeringen.
          && request.resource.data.get('andringar', []) is list
          && request.resource.data.get('andringar', []).size() <= 30
          // ALLTID .get() med default: en anmälan som saknar fältet (alla
          // befintliga) gör en direktläsning till ett evalueringsFEL som tyst
          // nekar HELA redigeringen. Den fällan har gått till prod två gånger.
          && request.resource.data.get('paymentClaims', []) is list
          && request.resource.data.get('paymentClaims', []).size() <= 20
        );
        allow delete: if isCompAdmin(cid);
      }

      // Kompletteringar per patrull. Kårledaren har anmälningslänken och kan
      // ändra ALLT i anmälan — den länken kan hen inte skicka vidare till varje
      // patrulledare. Därför en egen hemlighet per patrull: doc-id:t är en
      // slumpad token, och länken /komplettera/<cid>/<token> ger åtkomst till
      // EN patrulls rad och ingenting annat.
      //
      // `list` är member-only. `read` hade täckt både get och list, och då gick
      // hela kollektionen att räkna upp anonymt — varje token, alltså varje
      // patrulls uppgifter, inklusive allergier.
      match /kompletteringar/{token} {
        allow get: if true;
        allow list: if isCompMember(cid);
        // Kårledaren är ANONYM — det är hen som ska dela ut länkarna, inte
        // admin. Rules kan inte se att någon "har" anmälningslänken, men att
        // känna till ett regId ÄR att ha den: id:t är hemligheten, precis som
        // för kontrollerna. Kravet att anmälan finns stänger därför ute den som
        // bara gissar, och samtidigt spam mot en tävling utan anmälningar.
        // Dokumentet bär INTE regId. Doc-id:t är öppet läsbart (token ÄR
        // hemligheten), så ett regId här hade gjort kompletteringslänken
        // utbytbar mot hela anmälningslänken: patrulledaren kunde läsa ut
        // regId ur svaret och öppna /a/<cid>/<regId> med läs- OCH skrivrätt
        // till kårens alla patruller, kontaktuppgifter och betalningar.
        // Kopplingen ligger i stället på anmälan (`kompletteringar[]`), som
        // bara den med anmälningslänken når.
        allow create: if isCompAdmin(cid) || (
             !compIsDemo(cid) && !compClosed(cid)
          && request.resource.data.patrol is string
          && request.resource.data.patrol.size() <= 120
          && request.resource.data.keys().hasOnly(['patrol','antal','allergier','kontakt','ovrigt'])
        );
        allow delete: if isCompAdmin(cid);
        // Patrulledaren fyller i sina egna uppgifter. regId och patrullnamnet
        // är kårledarens och admins — kan de skrivas om pekar kompletteringen
        // på fel anmälan, eller döps om till en patrull som inte finns.
        allow update: if isCompAdmin(cid) || (
             !compIsDemo(cid) && !compClosed(cid)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['antal', 'allergier', 'kontakt', 'ovrigt', 'ifylltAt'])
          // patrol är kårledarens; kunde den skrivas om skulle raden döpas om
          // till en patrull som inte finns i anmälan.
          && (!('antal' in request.resource.data)
              || (request.resource.data.antal is int
                  && request.resource.data.antal >= 0
                  && request.resource.data.antal <= 20))
          && (!('allergier' in request.resource.data)
              || (request.resource.data.allergier is string
                  && request.resource.data.allergier.size() <= 500))
          && (!('kontakt' in request.resource.data)
              || (request.resource.data.kontakt is string
                  && request.resource.data.kontakt.size() <= 200))
          && (!('ovrigt' in request.resource.data)
              || (request.resource.data.ovrigt is string
                  && request.resource.data.ovrigt.size() <= 500))
        );
      }

      // PM-utskick till anmälda kårer. Admin CREATES a doc here; the
      // onUtskickCreated Cloud Function fans it out as mail to every active
      // registration contact and stamps sentAt/recipients back (admin SDK,
      // bypasses rules). Clients never write /mail/** directly.
      match /utskick/{utskickId} {
        allow read: if isCompMember(cid);
        allow create: if isCompAdmin(cid) && !compIsDemo(cid)
          && request.resource.data.keys().hasOnly(['subject', 'body', 'createdAt', 'createdBy'])
          && request.resource.data.subject is string
          && request.resource.data.body is string;
        allow delete: if isCompAdmin(cid) && !compIsDemo(cid);
      }

      // Invites (dormant — membership is email-based via adminEmails/userEmails).
      // Kept admin-only to avoid an arbitrary signed-in user rewriting an
      // invite's target if the flow is ever reactivated.
      match /invites/{inviteId} {
        allow read: if true; // token-based lookup
        allow write: if isCompAdmin(cid);
      }
    }
  }
}
