rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isSuperAdmin() {
      return isSignedIn() && userRole() == 'super-admin';
    }

    function compData(cid) {
      return get(/databases/$(database)/documents/competitions/$(cid)).data;
    }

    // All sign-ins are email-link, so every authenticated user has a verified
    // email claim. Permissions are email-based (people can be invited before
    // their first sign-in); legacy uid-based admins are still honored.
    function authEmail() {
      return request.auth.token.email.lower();
    }

    // Permission data is being migrated from the world-readable competition
    // doc into a member-only private/access subdoc (Fas 3). During the
    // migration the rules read a UNION of both places, so whichever is
    // populated grants access — a bug on the new side can't lock anyone out
    // while the old side is still dual-written.
    function accessExists(cid) {
      return exists(/databases/$(database)/documents/competitions/$(cid)/private/access);
    }
    function accessData(cid) {
      return get(/databases/$(database)/documents/competitions/$(cid)/private/access).data;
    }

    function isCompAdmin(cid) {
      return isSignedIn() && (isSuperAdmin()
        || request.auth.uid in compData(cid).get('admins', [])
        || authEmail() in compData(cid).get('adminEmails', [])
        || (accessExists(cid) && (
             request.auth.uid in accessData(cid).get('admins', [])
          || authEmail() in accessData(cid).get('adminEmails', [])
        )));
    }

    // Ekonomiansvarig/kassör — appointed via a Tävlingsledning role flagged
    // `ekonomi`; the flat email mirror lives ONLY in private/access. Grants
    // member-level read plus the paidRefs-only registration update below.
    function isEkonomi(cid) {
      return isSignedIn() && accessExists(cid)
        && authEmail() in accessData(cid).get('ekonomiEmails', []);
    }

    function isCompMember(cid) {
      return isCompAdmin(cid)
        || (isSignedIn() && authEmail() in compData(cid).get('userEmails', []))
        || (isSignedIn() && accessExists(cid) && authEmail() in accessData(cid).get('userEmails', []))
        || isEkonomi(cid);
    }

    // A competition flagged with demo: true is read-only for everyone except
    // super-admins. Used for the bundled "Demospår" that ships in prod so new
    // users can explore without being able to deface it.
    // NOTE: must use .get() with a default — competitions created without the
    // demo field would otherwise make this expression ERROR (reading a missing
    // property is an evaluation error in rules), which denied every anonymous
    // score/registration write on those competitions.
    function compIsDemo(cid) {
      return compData(cid).get('demo', false) == true;
    }

    // A closed (avslutad) competition is read-only for everyone but admins.
    function compClosed(cid) {
      return compData(cid).get('closed', false) == true;
    }

    function registrationEnabled(cid) {
      return compData(cid).get('registration', {}).get('enabled', false) == true;
    }

    // Control doc for score validation — fetched once and passed to the
    // shape check so we don't spend multiple get()s per rule evaluation.
    function ctrlData(cid, ctrlId) {
      return get(/databases/$(database)/documents/competitions/$(cid)/controls/$(ctrlId)).data;
    }

    // ansvarigaEmails is being moved from the control doc into its private/meta
    // subdoc (Fas 3). Read a union of both during the migration.
    function ctrlMetaExists(cid, ctrlId) {
      return exists(/databases/$(database)/documents/competitions/$(cid)/controls/$(ctrlId)/private/meta);
    }
    function ctrlMetaData(cid, ctrlId) {
      return get(/databases/$(database)/documents/competitions/$(cid)/controls/$(ctrlId)/private/meta).data;
    }
    function isCtrlAnsvarig(cid, ctrlId) {
      return isSignedIn() && (
        authEmail() in ctrlData(cid, ctrlId).get('ansvarigaEmails', [])
        || (ctrlMetaExists(cid, ctrlId) && authEmail() in ctrlMetaData(cid, ctrlId).get('ansvarigaEmails', []))
      );
    }

    // Shape/bounds check for an ANONYMOUS score write, given the already
    // fetched control data `c`. Enforces: control open, doc-id == patrolId,
    // point value within the control's [min,max], extra within [0,extra],
    // types, allowed keys, short note. Admins bypass this entirely.
    function anonScoreShape(c, scoreId, data) {
      return c.get('open', false) == true
        && scoreId == data.patrolId
        && data.patrolId is string
        && data.poang is number
        && data.poang >= c.get('minPoang', 0)
        && data.poang <= c.get('maxPoang', 100000)
        && (!('extraPoang' in data) || (data.extraPoang is number && data.extraPoang >= 0 && data.extraPoang <= c.get('extraPoang', 0)))
        && (!('utslagGissning' in data) || data.utslagGissning is number)
        && (!('note' in data) || (data.note is string && data.note.size() <= 500))
        && (!('clientReportedAt' in data) || data.clientReportedAt is timestamp)
        && data.keys().hasOnly(['patrolId','poang','extraPoang','note','reportedAt','clientReportedAt','reporter','utslagGissning','history']);
    }

    // --- Tävlingsförfrågningar
    // En inloggad användare kan inte skapa en tävling själv (se competitions
    // create) utan skickar en förfrågan med grunduppgifter + ett meddelande.
    // Super-admins får listan, godkänner eller nekar med ett svar tillbaka,
    // och det är godkännandet som skapar tävlingen med sökanden som admin.
    // En Cloud Function mailar super-admins vid ny förfrågan och sökanden
    // vid beslut (reagerar på create/update här — klienten rör aldrig /mail).
    //
    // Läsning: super-admin ser alla; sökanden ser sina egna (klienten frågar
    // med where('requestedBy','==',uid), vilket regeln nedan validerar per
    // dokument — en obegränsad list nekas för alla utom super-admin).
    match /competitionRequests/{reqId} {
      allow read: if isSuperAdmin()
        || (isSignedIn() && resource.data.requestedBy == request.auth.uid);

      // Högst TRE förfrågningar per konto, framtvingat via dokument-id:t:
      // "<uid>-0|1|2". Rules kan inte räkna dokument, men create nekas på ett
      // id som redan finns — alltså är tre platser ett hårt tak. Sökanden
      // frigör en plats genom att dölja en behandlad förfrågan.
      allow create: if isSignedIn()
        && reqId.matches('^' + request.auth.uid + '-[0-2]$')
        && request.resource.data.requestedBy == request.auth.uid
        && request.resource.data.requestedByEmail == authEmail()
        && request.resource.data.status == 'vantar'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.get('description', '') is string
        && request.resource.data.get('description', '').size() <= 2000
        && request.resource.data.get('message', '') is string
        && request.resource.data.get('message', '').size() <= 2000
        && (request.resource.data.get('date', null) == null
            || (request.resource.data.date is string && request.resource.data.date.size() <= 10))
        && request.resource.data.keys().hasOnly([
             'name', 'description', 'date', 'message',
             'requestedBy', 'requestedByEmail', 'status', 'createdAt'
           ]);

      // Beslutet (status/svar/competitionId) sätts bara av super-admin.
      allow update: if isSuperAdmin();

      // Super-admin städar; sökanden får rensa bort sin egen behandlade
      // förfrågan (kvittera ett nej) men inte radera en som väntar på svar.
      allow delete: if isSuperAdmin()
        || (isSignedIn()
            && resource.data.requestedBy == request.auth.uid
            && resource.data.status != 'vantar');
    }

    // --- System config (super-admin only). Operational settings tunable
    // without a deploy (e.g. mail rate-limit caps). Cloud Functions read it
    // via the admin SDK (bypassing rules).
    match /config/{doc} {
      allow read, write: if isSuperAdmin();
    }

    // --- Users
    // Any signed-in user may read the (email, role) of other users so that
    // competition admins can look up invitees by email. A user may only
    // create/update their own doc, and cannot elevate their own role — only
    // the pre-approved super-admin email may self-assign "super-admin".
    match /users/{uid} {
      // Own doc + super-admin only — a regular user must not be able to
      // enumerate every account's email/role.
      allow read: if isSignedIn() && (request.auth.uid == uid || isSuperAdmin());
      allow create: if isSignedIn() && request.auth.uid == uid
        && (
          request.resource.data.role == 'user'
          || (request.resource.data.role == 'super-admin'
              // MUST match SUPER_ADMIN_EMAIL in public/js/store.js
              && request.auth.token.email == 'johan@leitet.se')
        );
      allow update: if isSuperAdmin()
        || (isSignedIn() && request.auth.uid == uid
            && request.resource.data.role == resource.data.role);
      allow delete: if isSuperAdmin();
    }

    // --- Competitions
    match /competitions/{cid} {
      allow read: if true; // public read of competition meta is OK (names only)
      // Tävlingar skapas INTE fritt: en vanlig användare skickar en förfrågan
      // (competitionRequests nedan) som en super-admin godkänner, och det är
      // super-adminens klient som skapar dokumentet. Undantaget är
      // årgångskopiering — den som redan är admin på en tävling får kopiera
      // den till nästa år utan att gå via förfrågan (copiedFrom pekar på
      // ursprungstävlingen och måste vara en tävling hen administrerar).
      // OBS: läs alltid optionella fält med .get() — en direktläsning av en
      // saknad property är ett evaluation ERROR som nekar skrivningen.
      allow create: if isSuperAdmin()
        || (isSignedIn()
            && request.resource.data.get('demo', false) != true
            && request.resource.data.get('copiedFrom', '') is string
            && request.resource.data.get('copiedFrom', '') != ''
            && isCompAdmin(request.resource.data.copiedFrom));
      // Writes on a demo competition are locked to super-admin.
      allow update: if isSuperAdmin()
        || (isCompAdmin(cid) && !compIsDemo(cid));
      allow delete: if isSuperAdmin();

      // Member-only permission/PII mirror (Fas 3): adminEmails, userEmails,
      // admins, users, and (later) management. The rules read it via get()
      // in isCompAdmin/isCompMember; members read it to see the member list.
      match /private/{doc} {
        allow read: if isCompMember(cid);
        allow write: if isSuperAdmin() || (isCompAdmin(cid) && !compIsDemo(cid));
      }

      // Patrols — readable by anyone (ID is obscure anyway, used by control page)
      match /patrols/{pid} {
        allow read: if true;
        allow write: if isSuperAdmin() || (isCompAdmin(cid) && !compIsDemo(cid));

        // Internal meta (notering) — NOT public. Members read/admins write.
        match /private/{doc} {
          allow read: if isCompMember(cid);
          allow write: if isSuperAdmin() || (isCompAdmin(cid) && !compIsDemo(cid));
        }
      }

      // Controls — read public (ID is the secret). Create/delete by admins;
      // update also by the control's kontrollansvariga (email match), who may
      // edit everything EXCEPT the ansvariga lists themselves (no adding
      // friends / privilege changes) and only while the competition is open.
      match /controls/{ctrlId} {
        allow read: if true;
        allow create: if isSuperAdmin() || (isCompAdmin(cid) && !compIsDemo(cid));
        allow delete: if isSuperAdmin() || (isCompAdmin(cid) && !compIsDemo(cid));
        allow update: if isSuperAdmin()
          || (isCompAdmin(cid) && !compIsDemo(cid))
          || (
               isSignedIn()
            && !compIsDemo(cid)
            && !compClosed(cid)
            && (authEmail() in resource.data.get('ansvarigaEmails', [])
                || (ctrlMetaExists(cid, ctrlId) && authEmail() in ctrlMetaData(cid, ctrlId).get('ansvarigaEmails', [])))
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['ansvariga', 'ansvarigaEmails'])
          );

        // Scores — anonymous create/update allowed if control is open AND the
        // competition isn't a demo. Super-admin can always seed scores.
        match /scores/{scoreId} {
          allow read: if true;
          // Admins may always write scores (adjustments, backup restore).
          // Anonymous reporters: only while the control is open, with a
          // validated shape/bounds, doc-id bound to patrolId, and NO
          // ability to introduce or alter the (admin-authored) history trail.
          allow create: if isSuperAdmin() || (isCompAdmin(cid) && !compIsDemo(cid)) || (
               !compIsDemo(cid)
            && anonScoreShape(ctrlData(cid, ctrlId), scoreId, request.resource.data)
            && (!('history' in request.resource.data) || request.resource.data.history.size() == 0)
          );
          allow update: if isSuperAdmin() || (isCompAdmin(cid) && !compIsDemo(cid)) || (
               !compIsDemo(cid)
            && anonScoreShape(ctrlData(cid, ctrlId), scoreId, request.resource.data)
            && request.resource.data.get('history', []) == resource.data.get('history', [])
          );
          allow delete: if isSuperAdmin() || (isCompAdmin(cid) && !compIsDemo(cid));
        }

        // Internal/personal control meta (telefon, notering, ansvariga) — NOT
        // public. Read by members OR this control's kontrollansvarig; written
        // by admins OR the kontrollansvarig.
        //
        // A kontrollansvarig may edit telefon/notering AND invite co-ansvariga
        // to their own control — but APPEND-ONLY: the new ansvarigaEmails must
        // contain every existing entry (hasAll), so nobody can be removed and
        // the control can never be taken over. Removal stays admin-only, and
        // `welcomed` (the welcome-mail ledger) stays client-immutable.
        match /private/{doc} {
          allow read: if isCompMember(cid) || isCtrlAnsvarig(cid, ctrlId);
          allow create: if isSuperAdmin() || (isCompAdmin(cid) && !compIsDemo(cid))
            || (!compIsDemo(cid) && !compClosed(cid) && isCtrlAnsvarig(cid, ctrlId)
                && !request.resource.data.keys().hasAny(['welcomed'])
                && (!request.resource.data.keys().hasAny(['ansvariga', 'ansvarigaEmails'])
                    || request.resource.data.get('ansvarigaEmails', [])
                         .hasAll(ctrlData(cid, ctrlId).get('ansvarigaEmails', []))));
          allow update: if isSuperAdmin() || (isCompAdmin(cid) && !compIsDemo(cid))
            || (!compIsDemo(cid) && !compClosed(cid) && isCtrlAnsvarig(cid, ctrlId)
                && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['welcomed'])
                && request.resource.data.get('ansvarigaEmails', [])
                     .hasAll(resource.data.get('ansvarigaEmails', [])));
        }
      }

      // Spårdragning — the course polylines drawn in the Spår editor. One
      // doc ("main") holding waypoints per leg. Same visibility as controls
      // (which already expose every position publicly); only admins draw.
      match /track/{docId} {
        allow read: if true;
        allow write: if isSuperAdmin() || (isCompAdmin(cid) && !compIsDemo(cid));
      }

      // Start/Mål-station — the station doc ID is the secret in the station
      // URL (/m/<cid>/<stationId>), same trust model as reporter links. The
      // station crew checks patrols out at start and in at mål; passages hold
      // one doc per patrol with server timestamps. Anyone holding the link
      // may write passages while the competition is open; list is member-only
      // so the secret can't be enumerated anonymously.
      match /stations/{stationId} {
        allow get: if true;
        // list is member-only so secret station ids can't be enumerated —
        // except on demo competitions, where the account-free demo mode
        // shows the station card on Läget (check-ins are blocked anyway).
        allow list: if isCompMember(cid) || compIsDemo(cid);
        allow create, update, delete: if isSuperAdmin() || (isCompAdmin(cid) && !compIsDemo(cid));

        match /passages/{patrolId} {
          allow read: if true;
          allow create: if isCompAdmin(cid) || (
               !compIsDemo(cid) && !compClosed(cid)
            && request.resource.data.keys().hasOnly(['patrolId', 'startAt', 'finishAt'])
            && request.resource.data.patrolId == patrolId
            && (!('startAt' in request.resource.data) || request.resource.data.startAt is timestamp)
            && (!('finishAt' in request.resource.data) || request.resource.data.finishAt is timestamp)
          );
          allow update: if isCompAdmin(cid) || (
               !compIsDemo(cid) && !compClosed(cid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['startAt', 'finishAt'])
            && request.resource.data.patrolId == patrolId
            && (!('startAt' in request.resource.data) || request.resource.data.startAt is timestamp)
            && (!('finishAt' in request.resource.data) || request.resource.data.finishAt is timestamp)
          );
          allow delete: if isSuperAdmin() || (isCompAdmin(cid) && !compIsDemo(cid));
        }
      }

      // Meddelanden (broadcast v2) — parallella driftmeddelanden från
      // ledningen till fältsidorna. Publikt läsbara (fältsidorna är anonyma —
      // composern varnar för personuppgifter), admin-skrivna. Varje meddelande
      // kan begära bekräftelse: klienterna skriver då kvittensdokument i
      // acks/ — anonymt (samma trustmodell som poängrapporter) men med hårt
      // validerad form och deterministiskt doc-id (<kind>-<refId>) så
      // omkvittering skriver över i stället för att växa. Acks får BARA läsas
      // av medlemmar: kvittenserna innehåller stations-id (hemligt) och ska
      // inte gå att enumerera anonymt.
      match /messages/{msgId} {
        allow read: if true;
        allow create, update, delete: if isSuperAdmin() || (isCompAdmin(cid) && !compIsDemo(cid));

        // Anonyma kvittenser är hårt grindade:
        //  - föräldermeddelandet måste finnas, vara aktivt och kräva
        //    bekräftelse (get() på saknat dokument fel-terminerar = deny,
        //    vilket också stoppar föräldralösa spam-dokument under påhittade
        //    meddelande-id:n),
        //  - refId måste vara ett EXISTERANDE kontroll-/patrull-/stations-
        //    dokument (binder dokumentrymden; stations-id är dessutom
        //    hemligt så stations-kvittenser kan inte förfalskas),
        //  - stämplarna är append-only (en befintlig seenAt/ackAt kan aldrig
        //    ändras eller raderas anonymt — samma princip som poäng-history)
        //    och får inte vara daterade i framtiden.
        // Kvarstående, medveten lucka: kontroll-/patrull-id:n är publikt
        // läsbara (anonyma sidor kräver det), så en kvittens KAN förfalskas
        // för en existerande mottagare — UI:t presenterar därför kvittenser
        // som lägesbild, inte facit.
        match /acks/{ackId} {
          allow read: if isCompMember(cid);
          allow create, update: if isSuperAdmin() || (isCompAdmin(cid) && !compIsDemo(cid)) || (
               !compIsDemo(cid) && !compClosed(cid)
            && get(/databases/$(database)/documents/competitions/$(cid)/messages/$(msgId)).data.get('requireAck', false) == true
            && get(/databases/$(database)/documents/competitions/$(cid)/messages/$(msgId)).data.get('active', false) == true
            && ackId == request.resource.data.kind + '-' + request.resource.data.refId
            && request.resource.data.kind in ['kontroll', 'patrull', 'station']
            && request.resource.data.refId is string
            && request.resource.data.refId.size() > 0
            && request.resource.data.refId.size() <= 64
            && (
                 (request.resource.data.kind == 'kontroll' && exists(/databases/$(database)/documents/competitions/$(cid)/controls/$(request.resource.data.refId)))
              || (request.resource.data.kind == 'patrull'  && exists(/databases/$(database)/documents/competitions/$(cid)/patrols/$(request.resource.data.refId)))
              || (request.resource.data.kind == 'station'  && exists(/databases/$(database)/documents/competitions/$(cid)/stations/$(request.resource.data.refId)))
            )
            && request.resource.data.keys().hasOnly(['kind', 'refId', 'seenAt', 'ackAt'])
            && (!('seenAt' in request.resource.data) || (request.resource.data.seenAt is timestamp && request.resource.data.seenAt < request.time + duration.value(5, 'm')))
            && (!('ackAt' in request.resource.data) || (request.resource.data.ackAt is timestamp && request.resource.data.ackAt < request.time + duration.value(5, 'm')))
            && (resource == null || !('seenAt' in resource.data) || request.resource.data.get('seenAt', null) == resource.data.seenAt)
            && (resource == null || !('ackAt' in resource.data) || request.resource.data.get('ackAt', null) == resource.data.ackAt)
          );
          allow delete: if isSuperAdmin() || (isCompAdmin(cid) && !compIsDemo(cid));
        }
      }

      // Registrations (Anmälan) — the doc ID is the secret manage link, same
      // trust model as control reporter URLs. Anyone holding the link may read
      // and update their registration while registration is enabled; only
      // competition members may list all registrations. Period enforcement
      // (open/closed dates) is handled in the UI by design.
      match /registrations/{regId} {
        allow get: if true;
        allow list: if isCompMember(cid);
        // Anonymous manage-link holders may only touch participant fields.
        // Payment status lives in the admin-only `paidRefs` array (see
        // isPaymentPaid), and the admin stamps reminder*/imported — none of
        // which a non-admin can create or change. hasOnly on create, and
        // affectedKeys on update so admin-added fields don't lock out the
        // registrant's own later edits.
        allow create: if isCompAdmin(cid) || (
             registrationEnabled(cid) && !compIsDemo(cid) && !compClosed(cid)
          && request.resource.data.keys().hasOnly(['kar','contact','patrols','answers','mode','totalAmount','payments','cancelled','forhinder','createdAt','updatedAt'])
        );
        allow update: if isCompAdmin(cid) || (
          // Ekonomiansvarig ticks payments off: may touch ONLY the
          // authoritative paidRefs array — no participant data, no amounts.
             isEkonomi(cid) && !compIsDemo(cid) && !compClosed(cid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paidRefs'])
        ) || (
             registrationEnabled(cid) && !compIsDemo(cid) && !compClosed(cid)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['kar','contact','patrols','answers','mode','totalAmount','payments','cancelled','forhinder','updatedAt'])
        );
        allow delete: if isCompAdmin(cid);
      }

      // PM-utskick till anmälda kårer. Admin CREATES a doc here; the
      // onUtskickCreated Cloud Function fans it out as mail to every active
      // registration contact and stamps sentAt/recipients back (admin SDK,
      // bypasses rules). Clients never write /mail/** directly.
      match /utskick/{utskickId} {
        allow read: if isCompMember(cid);
        allow create: if isCompAdmin(cid) && !compIsDemo(cid)
          && request.resource.data.keys().hasOnly(['subject', 'body', 'createdAt', 'createdBy'])
          && request.resource.data.subject is string
          && request.resource.data.body is string;
        allow delete: if isCompAdmin(cid) && !compIsDemo(cid);
      }

      // Invites (dormant — membership is email-based via adminEmails/userEmails).
      // Kept admin-only to avoid an arbitrary signed-in user rewriting an
      // invite's target if the flow is ever reactivated.
      match /invites/{inviteId} {
        allow read: if true; // token-based lookup
        allow write: if isCompAdmin(cid);
      }
    }
  }
}
